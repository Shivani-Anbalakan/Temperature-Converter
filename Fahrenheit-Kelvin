int main() {
    float F,K;
    int choice;
    printf("1.Fahrenheit to Kelvin\n");
    printf("2.Kelvin to Fahrenheit\n");
    printf("Choose 1 or 2:");
    scanf("%d",&choice);
    if (choice==1) {
        printf("Temperature:");
        scanf("%f",&F);
        K = (F-32)/1.8+273.15;
        printf("%.2f",K,"K\n");
    }
    else if (choice==2) {
        printf("Temperature:");
        scanf("%f",&K);
        F = (K-273.15)*1.8+32;
        printf("%.2f deg F\n",F);
    }
    else {
        printf("Choice invalid");
    }
    return 0;
}
